# ═══ Memo BauT — Environment Variables ═══
# Kopiere diese Datei als .env.local und setze die Werte.
# .env.local wird NICHT in Git committed.

# ─── Formspree (Kontaktformular) ───
# Deine Formspree Form-ID (öffentlich, kein Secret)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/DEINE_FORM_ID

# ─── Google Analytics 4 (Optional) ───
# GA4 Measurement-ID (öffentlich). Leer lassen = GA4 deaktiviert.
VITE_GA_MEASUREMENT_ID=

# ─── Feature Flags (Optional, Overrides) ───
# VITE_FF_TESTIMONIALS=true
# VITE_FF_ANIMATIONS=true
# VITE_FF_GALLERY_FILTER=true
# VITE_FF_BLOG=true
# VITE_FF_CALENDLY=true
# VITE_FF_SCROLL_PROGRESS=true
# VITE_FF_STICKY_CTA=true
